---
import themes from '../data/themes.json';
import publications from '../data/publications.json';
const byId = Object.fromEntries(publications.publications.map(p => [p.id, p]));
const years = [...new Set(publications.publications.map(p => Number(p.year)))].sort((a, b) => b - a);
---
<nav class="map" id="map" aria-label="Page map">
  <div class="map-items" id="map-items">
    {themes.map((th, ti) => (<>
      <a class={`map-item is-section${ti > 0 ? ' gap' : ''}`} data-th={th.id} href={`#t-${th.id}`} data-map={`t-${th.id}`} aria-label={th.name}><i class="map-tick"></i><span class="map-l">{th.name}</span></a>
      {th.papers.map(id => <a class="map-item" data-th={th.id} href={`#w-${id}`} data-map={`w-${id}`} aria-label={byId[id].shortName}><i class="map-tick"></i><span class="map-l">{byId[id].shortName}</span></a>)}
    </>))}
    <a class="map-item is-section gap" href="#publications" data-map="publications" aria-label="All Publications"><i class="map-tick"></i><span class="map-l">All Publications</span></a>
    {years.map(y => <a class="map-item is-year" href={`#y-${y}`} data-map={`y-${y}`} aria-label={`Publications from ${y}`}><i class="map-tick"></i><span class="map-l">{y}</span></a>)}
  </div>
</nav>
