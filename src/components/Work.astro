---
import themes from '../data/themes.json';
import publications from '../data/publications.json';
import Entry from './Entry.astro';
const byId = Object.fromEntries(publications.publications.map(p => [p.id, p]));
const ICON = {
  expanding: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 2.5h4v4M13.5 2.5 8.8 7.2M6.5 13.5h-4v-4M2.5 13.5l4.7-4.7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  navigating: '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.6 5.4 9.3 9.3 5.4 10.6l1.3-3.9z" fill="currentColor"/></svg>',
  modeling: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 5.2v2.3M8 7.5 4 11M8 7.5l4 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="3.6" r="1.9" fill="currentColor"/><circle cx="4" cy="12.2" r="1.9" fill="currentColor"/><circle cx="12" cy="12.2" r="1.9" fill="currentColor"/></svg>',
};
---
<div class="sel-h" id="selected"><h2>Selected work</h2><span class="note">Each figure is a hand-built walkthrough of the system, not live model output.</span></div>
{themes.map(th => (
  <section class="theme" id={`t-${th.id}`} data-th={th.id} data-spy data-section data-label={th.name}>
    <div class="theme-h"><i class="theme-ic" set:html={ICON[th.id]} /><h2>{th.name}</h2><p class="intro">{th.intro}</p></div>
    {th.papers.map(id => <Entry paper={byId[id]} />)}
  </section>
))}
