---
import Stylette from './demos/Stylette.astro';
import Cells from './demos/Cells.astro';
import EvalLM from './demos/EvalLM.astro';
import Evalet from './demos/Evalet.astro';
import Cupid from './demos/Cupid.astro';
import Discover from './demos/Discover.astro';
import profile from '../data/profile.json';
const { paper } = Astro.props;
const DEMO = { 'stylette': Stylette, 'cells-generators-lenses': Cells, 'evallm': EvalLM, 'evalet': Evalet, 'cupid': Cupid, 'discoverllm': Discover };
const Demo = DEMO[paper.id];
const links = Object.entries(paper.links || {});
const LABEL = { pdf:'Paper', website:'Website', code:'Code', data:'Data', arxiv:'arXiv', acmdl:'ACM DL', video:'Video', demo:'Demo' };
const authors = paper.authors || [];
const primary = links.find(([k]) => k === 'pdf') || links[0] || null;
---
<article class="entry" id={`w-${paper.id}`} data-spy data-label={paper.shortName}>
  <div class="meta">
    <div class="entry-k"><span>{paper.venue} {paper.year}</span>{paper.award && <span class="award">{paper.award.replace(' Award','')}</span>}</div>
    <h3>{primary ? <a href={primary[1]} target="_blank" rel="noopener">{paper.title}</a> : paper.title}</h3>
    <p class="authors">{authors.map((a, i) => <>{a.name === profile.name ? <b>{a.name}</b> : (a.url ? <a href={a.url} target="_blank" rel="noopener">{a.name}</a> : a.name)}{a.equalContrib ? '*' : ''}{i < authors.length - 1 ? ', ' : ''}</>)}</p>
    <nav class="entry-links" aria-label={`Links for ${paper.shortName}`}>{links.map(([k, url]) => <a href={url} target="_blank" rel="noopener">{LABEL[k] || k}</a>)}</nav>
  </div>
  {Demo && <Demo />}
</article>
