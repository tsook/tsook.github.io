<div class="fig" data-demo="discover">
  <div class="dlf">
    <div class="dl-conv" data-step="1">
      <div class="turn-row always"><div><div class="msg"><span class="who you">You</span><span class="tx">Write a poem about my younger self.</span></div></div></div>
      <div class="turn-row" data-turn="1"><div><div class="msg"><span class="who">Model</span><span class="tx">Here is a draft: <em>She kept her coat on indoors that year…</em></span><span class="rw">R = 0</span></div></div></div>
      <div class="turn-row" data-turn="2"><div><div class="msg"><span class="who">Model</span><span class="tx">What would you like to change?</span></div><div class="msg"><span class="who you">You</span><span class="tx">I am not sure.</span><span class="rw">R = 0</span></div></div></div>
      <div class="turn-row" data-turn="3"><div><div class="msg"><span class="who">Model</span><span class="tx">Looking back on her, or talking to her directly?</span></div><div class="msg"><span class="who you">You</span><span class="tx">Talking to her.</span><span class="rw plus">R = +2</span></div></div></div>
      <div class="dl-actions"><button class="btn" data-act="step">Next turn</button><span class="k" data-dlk>1 of 3</span></div>
    </div>
    <div class="dl-state">
      <span class="lab">Intent state</span>
      <div class="tree">
        <span class="node found">Subject</span>
        <span class="node" data-n="perspective">Perspective</span>
        <span class="node child" data-n="second">Second person</span>
        <span class="node" data-n="tone">Tone</span>
        <span class="node child" data-n="tender">Tender</span>
      </div>
      <div class="prog" data-prog><i class="on"></i><i></i><i></i><i></i><i></i></div>
    </div>
  </div>
</div>
