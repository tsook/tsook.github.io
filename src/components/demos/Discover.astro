<div class="fig" data-demo="discover">
  <div class="dl">
    <div class="dl-conv">
      <div class="dl-top">
        <span class="dl-mode"><button data-act="mode" data-mode="base">Base model</button><button class="is-on" data-act="mode" data-mode="dl">DiscoverLLM</button></span>
        <button class="dl-next" data-act="next">Next turn</button>
      </div>
      <div class="dl-turns" data-turns></div>
    </div>
    <div class="dl-state">
      <span class="dl-lab">The user's latent intents</span>
      <div class="dl-tree" data-tree></div>
      <div class="dl-prog">
        <span class="dl-lab">Discovered <b data-progk></b></span>
        <div class="dl-bar" data-bar></div>
      </div>
      <p class="dl-note">The user can only ask for what it has discovered. <span class="dl-key">R = newly discovered intents − length penalty</span></p>
    </div>
  </div>
</div>
