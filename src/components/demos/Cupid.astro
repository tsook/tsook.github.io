<div class="fig" data-demo="cupid">
  <svg class="cu-link" aria-hidden="true"></svg>
  <div class="cu">
    <div class="cu-left">
      <span class="cu-lab">Earlier sessions</span>
      <div class="cu-sessions" data-sessions></div>
      <span class="cu-lab">Session 9 · now</span>
      <div class="cu-req"><mark data-req-mark></mark><span class="cu-req-t" data-req></span></div>
      <div class="cu-reqs"><span class="cu-try">Try</span><span data-reqs></span></div>
    </div>
    <div class="cu-model">
      <span class="cu-lab">Model</span>
      <div class="cu-step" data-step="ctx"><span class="cu-k">Shares a factor with</span><span class="cu-v" data-ctx></span></div>
      <div class="cu-step" data-step="pref"><span class="cu-k">Preference to honor</span><span class="cu-v" data-pref></span></div>
      <div class="cu-step" data-step="resp"><span class="cu-k">Response</span><span class="cu-v" data-resp></span></div>
    </div>
  </div>
</div>
