<div class="fig" data-demo="cupid">
  <div class="cu">
    <div class="cu-hist">
      <span class="cu-lab">Earlier sessions with this user</span>
      <div class="cu-line">
        <button class="cu-sess" data-act="sess" data-s="0">
          <span class="cu-sn">Session 1</span>
          <mark class="f-blue">Canon MP-E lens</mark>
          <span class="cu-sd">Macro shoot of leaf-cutter ant mandibles.</span>
          <span class="cu-verdict" data-verdict="0"></span>
          <span class="cu-peek"><b>Preference they showed</b>Technical specs first, in detail, before creative suggestions.</span>
        </button>
        <span class="cu-gap">Sessions 2 to 6</span>
        <button class="cu-sess" data-act="sess" data-s="1">
          <span class="cu-sn">Session 7</span>
          <mark class="f-violet">PBS Nature</mark>
          <span class="cu-sd">Segment treatment on butterfly metamorphosis.</span>
          <span class="cu-verdict" data-verdict="1"></span>
          <span class="cu-peek"><b>Preference they showed</b>Observational detail only, no artificial drama.</span>
        </button>
        <span class="cu-gap">Session 8</span>
        <div class="cu-sess cu-now">
          <span class="cu-sn">Session 9 · now</span>
          <p class="cu-req" data-req></p>
          <div class="cu-reqs"><span class="cu-try">Try</span><span data-reqs></span></div>
        </div>
      </div>
    </div>
    <div class="cu-model">
      <span class="cu-lab">What the model must infer</span>
      <div class="cu-step" data-step="ctx"><span class="cu-k">Relevant context factor</span><span class="cu-v" data-ctx></span></div>
      <div class="cu-step" data-step="pref"><span class="cu-k">Contextual preference</span><span class="cu-v" data-pref></span></div>
      <div class="cu-step cu-resp" data-step="resp"><span class="cu-k">Response</span><p class="cu-v" data-resp></p></div>
    </div>
  </div>
</div>
