<div class="fig" data-demo="stylette">
  <div class="stf">
    <div class="stf-el">
      <div class="stf-h">Saturday market</div>
      <p class="stf-t" data-target>Forty stalls of produce, bread, and flowers on the east bank.</p>
      <div class="bubble"><i></i>tone down the text</div>
    </div>
    <div class="stf-sugg">
      <div class="sg"><span class="sg-k">Change <b>color</b></span><span class="sg-b">
        <button class="sug" data-act="st" data-p="color" data-v="#6E6E68"><i class="sw" style="--c:#6E6E68"></i>6E6E68</button>
        <button class="sug" data-act="st" data-p="color" data-v="#8C8C85"><i class="sw" style="--c:#8C8C85"></i>8C8C85</button>
        <button class="sug" data-act="st" data-p="color" data-v="#4B4B46"><i class="sw" style="--c:#4B4B46"></i>4B4B46</button></span></div>
      <div class="sg"><span class="sg-k">Change <b>font-family</b></span><span class="sg-b">
        <button class="sug" data-act="st" data-p="font" data-v="Georgia, serif" style="font-family:Georgia,serif">Serif</button>
        <button class="sug" data-act="st" data-p="font" data-v="'Geist Mono', monospace" style="font-family:'Geist Mono',monospace">Mono</button>
        <button class="sug" data-act="st" data-p="font" data-v="'Helvetica Neue', Arial, sans-serif" style="font-family:'Helvetica Neue',Arial,sans-serif;font-weight:300">Light</button></span></div>
      <div class="sg"><span class="sg-k">Decrease <b>font-size</b></span><span class="sg-b">
        <button class="sug" data-act="st" data-p="size" data-v="13px">13px</button>
        <button class="sug" data-act="st" data-p="size" data-v="12px">12px</button>
        <button class="sug" data-act="st" data-p="size" data-v="11px">11px</button></span></div>
    </div>
  </div>
</div>
