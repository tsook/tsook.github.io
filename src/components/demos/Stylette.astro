<div class="fig" data-demo="stylette">
  <div class="st">
    <div class="st-left">
      <button class="st-mic" data-act="mic" aria-label="Speak the next request">
        <svg class="st-mic-ic" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="1.5" width="5" height="8" rx="2.5" fill="currentColor"/><path d="M3.5 7.5a4.5 4.5 0 0 0 9 0M8 12v2.5M5.5 14.5h5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <span class="st-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
        <span class="st-said" data-mic-text>Tap to speak</span>
        <span class="st-next" aria-hidden="true">next ▸</span>
      </button>
      <div class="st-page">
        <div class="st-bar"><i></i><i></i><i></i><span>saturdaymarket.org</span></div>
        <div class="st-body">
          <div class="st-nav"><b>Saturday Market</b><span>Stalls</span><span>Visit</span></div>
          <h4 class="st-el st-h" data-el="h">Fresh from the east bank</h4>
          <p class="st-el st-p" data-el="p">Forty stalls of produce, bread, and flowers, every Saturday from seven until noon.</p>
          <span class="st-el st-b" data-el="b">Plan your visit</span>
        </div>
      </div>
    </div>
    <div class="st-pal">
      <div class="st-pal-h"><span class="st-logo">Stylette</span><span class="st-status" data-status>Select an element and speak.</span></div>
      <div class="st-cols" data-cols></div>
    </div>
  </div>
</div>
