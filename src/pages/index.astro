---
import Base from '../layouts/Base.astro';
import Side from '../components/Side.astro';
import Work from '../components/Work.astro';
import Publications from '../components/Publications.astro';
import profile from '../data/profile.json';
---
<Base title={profile.name}>
  <div class="page">
    <Side />
    <main class="main" id="main">
      <Work />
      <Publications />
    </main>
  </div>
  <footer class="foot"><span class="foot-copy">© 2026 {profile.name}</span></footer>
</Base>
<script>
  import { initDemos } from '../scripts/demos.js';
  import { initMap } from '../scripts/map.js';
  initDemos();
  initMap();
</script>
